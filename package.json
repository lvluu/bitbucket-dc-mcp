{
  "name": "bitbucket-dc-mcp",
  "version": "1.0.0",
  "description": "HTTP MCP server for Bitbucket Data Center REST API",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && chmod 755 build/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node build/index.js",
    "inspect:http": "npm run build && npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "dev": "npm run build && node dev",
    "serve:stdio": "npm run build && MCP_TRANSPORT=stdio node build/index.js",
    "serve:http": "npm run build && MCP_TRANSPORT=http PORT=3000 node build/index.js",
    "gen:tool": "hygen tool new",
    "gen:prompt": "hygen prompt new",
    "gen:resource": "hygen resource new",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:fix": "knip --fix"
  },
  "keywords": [
    "mcp",
    "bitbucket",
    "bitbucket-datacenter",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/node": "^24.9.1",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "hygen": "^6.2.11",
    "knip": "^5.66.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.18"
  },
  "bin": {
    "bitbucket-dc-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ]
}
